<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Track Ride | Pahatid System</title>
    
    <!-- CSS Libraries -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
    
    <!-- Custom Stylesheet -->
    <link rel="stylesheet" href="../assets/css/style.css">
    
    <style>
        .tracking-container {
            height: calc(100vh - 70px); /* Full screen minus navbar */
            display: flex;
            flex-direction: column;
        }
        #map-container {
            flex-grow: 1;
            border-radius: 0;
            z-index: 1;
        }
        .control-panel {
            background: white;
            box-shadow: 0 -5px 20px rgba(0,0,0,0.1);
            padding: 1.5rem;
            border-top-left-radius: 1.5rem;
            border-top-right-radius: 1.5rem;
            position: relative;
            z-index: 1000;
            max-height: 45vh;
            overflow-y: auto;
        }
        .status-step {
            display: flex;
            align-items: center;
            margin-bottom: 1rem;
            opacity: 0.5;
            transition: all 0.3s ease;
        }
        .status-step.active {
            opacity: 1;
        }
        .status-icon {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: #e9ecef;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 1rem;
            font-size: 0.8rem;
        }
        .status-step.active .status-icon {
            background: var(--pahatid-primary);
            color: white;
        }
        .status-step.completed .status-icon {
            background: var(--pahatid-success);
            color: white;
        }
        .driver-info-card {
            background: #f8f9fa;
            border-radius: 1rem;
            padding: 1rem;
            margin-bottom: 1rem;
        }
        .pulse-dot {
            height: 10px;
            width: 10px;
            background-color: var(--pahatid-success);
            border-radius: 50%;
            display: inline-block;
            animation: pulse-green 2s infinite;
        }
        @keyframes pulse-green {
            0% { box-shadow: 0 0 0 0 rgba(25, 135, 84, 0.7); }
            70% { box-shadow: 0 0 0 10px rgba(25, 135, 84, 0); }
            100% { box-shadow: 0 0 0 0 rgba(25, 135, 84, 0); }
        }
    </style>
</head>
<body class="bg-light d-flex flex-column vh-100">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm py-2">
        <div class="container-fluid px-4">
            <a class="navbar-brand fw-bold" href="/index.html">
                <i class="fas fa-motorcycle me-2"></i>Pahatid<span class="text-warning">System</span>
            </a>
            <div class="ms-auto">
                <a href="dashboard.html" class="btn btn-outline-light btn-sm"><i class="fas fa-home me-1"></i> Exit</a>
            </div>
        </div>
    </nav>

    <div class="tracking-container">
        
        <!-- Map Area -->
        <div id="map-container"></div>

        <!-- Bottom Control Panel -->
        <div class="control-panel">
            
            <!-- Header Info -->
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                <div>
                    <h5 class="mb-0 fw-bold">Tracking Ride</h5>
                    <small class="text-muted">Ref: <span id="refCodeText">...</span></small>
                </div>
                <div class="text-end">
                    <span class="badge bg-secondary" id="tripStatusBadge">Waiting...</span>
                </div>
            </div>

            <!-- Driver Info (Hidden until assigned) -->
            <div id="driverSection" class="driver-info-card hidden">
                <div class="d-flex align-items-center gap-3">
                    <img src="../assets/img/default-avatar.png" alt="Driver" class="rounded-circle" style="width: 50px; height: 50px; object-fit: cover;" id="driverAvatar">
                    <div class="flex-grow-1">
                        <h6 class="mb-0 fw-bold" id="driverName">Loading...</h6>
                        <div class="d-flex align-items-center gap-2 small text-muted">
                            <span><i class="fas fa-star text-warning"></i> <span id="driverRating">5.0</span></span>
                            <span>|</span>
                            <span><i class="fas fa-motorcycle"></i> <span id="driverVehicle">--</span></span>
                        </div>
                    </div>
                    <button class="btn btn-success btn-sm rounded-circle p-2" onclick="callDriver()">
                        <i class="fas fa-phone"></i>
                    </button>
                </div>
            </div>

            <!-- Status Timeline -->
            <div class="mt-3">
                <div class="status-step active" id="step-requested">
                    <div class="status-icon"><i class="fas fa-clock"></i></div>
                    <div>
                        <strong>Ride Requested</strong>
                        <p class="small text-muted mb-0">We're looking for a nearby driver.</p>
                    </div>
                </div>
                
                <div class="status-step" id="step-accepted">
                    <div class="status-icon"><i class="fas fa-check"></i></div>
                    <div>
                        <strong>Driver Assigned</strong>
                        <p class="small text-muted mb-0">Your driver is on the way.</p>
                    </div>
                </div>

                <div class="status-step" id="step-in_progress">
                    <div class="status-icon"><i class="fas fa-route"></i></div>
                    <div>
                        <strong>Trip Started</strong>
                        <p class="small text-muted mb-0">Enjoy your ride!</p>
                    </div>
                </div>

                <div class="status-step" id="step-completed">
                    <div class="status-icon"><i class="fas fa-flag-checkered"></i></div>
                    <div>
                        <strong>Trip Completed</strong>
                        <p class="small text-muted mb-0">Please rate your experience.</p>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-grid gap-2 mt-4" id="actionButtons">
                <button class="btn btn-outline-danger" id="cancelBtn" onclick="cancelRide()">Cancel Ride</button>
            </div>

            <!-- Rating Modal Placeholder (Shown via JS when completed) -->
            <div id="ratingModal" class="hidden mt-4 p-3 bg-light rounded border">
                <h6 class="fw-bold mb-2">Rate Your Trip</h6>
                <div class="star-rating mb-2" id="starContainer">
                    <i class="far fa-star fa-2x text-warning cursor-pointer" data-val="1"></i>
                    <i class="far fa-star fa-2x text-warning cursor-pointer" data-val="2"></i>
                    <i class="far fa-star fa-2x text-warning cursor-pointer" data-val="3"></i>
                    <i class="far fa-star fa-2x text-warning cursor-pointer" data-val="4"></i>
                    <i class="far fa-star fa-2x text-warning cursor-pointer" data-val="5"></i>
                </div>
                <textarea class="form-control mb-2" placeholder="Any comments?" rows="2" id="reviewComment"></textarea>
                <button class="btn btn-primary w-100" onclick="submitReview()">Submit Review</button>
            </div>

        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    
    <script type="module">
        import { supabase, formatCurrency } from '../assets/js/config.js';

        // --- STATE MANAGEMENT ---
        let currentBookingId = null;
        let mapInstance = null;
        let pickupMarker = null;
        let dropoffMarker = null;
        let driverMarker = null;
        let routeLine = null;
        let realtimeChannel = null;
        let selectedRating = 0;

        // DOM Elements
        const refCodeText = document.getElementById('refCodeText');
        const tripStatusBadge = document.getElementById('tripStatusBadge');
        const driverSection = document.getElementById('driverSection');
        const cancelBtn = document.getElementById('cancelBtn');
        const ratingModal = document.getElementById('ratingModal');

        // --- INITIALIZATION ---
        document.addEventListener('DOMContentLoaded', async () => {
            // Get Booking ID from URL params (?id=...)
            const urlParams = new URLSearchParams(window.location.search);
            currentBookingId = parseInt(urlParams.get('id'));

            if (!currentBookingId) {
                alert("Invalid booking reference.");
                window.location.href = 'dashboard.html';
                return;
            }

            await checkAuth();
            initMap();
            loadInitialData();
            subscribeToRealtimeUpdates();
        });

        async function checkAuth() {
            const { data: { session } } = await supabase.auth.getSession();
            if (!session) {
                window.location.href = '/login.html';
                return;
            }
        }

        function initMap() {
            mapInstance = L.map('map-container').setView([14.5995, 120.9842], 13);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(mapInstance);
        }

        // --- LOAD INITIAL DATA ---
        async function loadInitialData() {
            try {
                // Fetch Booking Details
                const { data: booking, error } = await supabase
                    .from('bookings')
                    .select(`
                        *,
                        profiles:commuter_profile_id(full_name),
                        drivers:driver_profile_id(
                            *,
                            profiles:user_profile_id(full_name, avatar_url)
                        )
                    `)
                    .eq('booking_id', currentBookingId)
                    .single();

                if (error || !booking) throw new Error("Booking not found");

                // Update UI Static Parts
                refCodeText.textContent = booking.reference_code;
                updateStatusUI(booking.trip_status);
                
                // Draw Pickup/Dropoff Markers
                drawRouteMarkers(booking);

                // If Driver Already Assigned, Show Info
                if (booking.drivers && booking.drivers.profiles) {
                    showDriverInfo(booking.drivers);
                }

            } catch (err) {
                console.error(err);
                alert("Error loading trip details.");
            }
        }

        function drawRouteMarkers(booking) {
            // Clear existing
            if(pickupMarker) mapInstance.removeLayer(pickupMarker);
            if(dropoffMarker) mapInstance.removeLayer(dropoffMarker);
            if(routeLine) mapInstance.removeLayer(routeLine);

            const pickupCoords = [parseFloat(booking.pickup_lat), parseFloat(booking.pickup_lng)];
            const dropoffCoords = [parseFloat(booking.dropoff_lat), parseFloat(booking.dropoff_lng)];

            pickupMarker = L.marker(pickupCoords).addTo(mapInstance).bindPopup("Pickup");
            dropoffMarker = L.marker(dropoffCoords).addTo(mapInstance).bindPopup("Drop-off");
            
            routeLine = L.polyline([pickupCoords, dropoffCoords], {color: '#0d6efd'}).addTo(mapInstance);
            
            // Fit bounds to show both points
            mapInstance.fitBounds(routeLine.getBounds());
        }

        function showDriverInfo(driverData) {
            driverSection.classList.remove('hidden');
            document.getElementById('driverName').textContent = driverData.profiles.full_name;
            document.getElementById('driverRating').textContent = driverData.average_rating?.toFixed(2) || '5.00';
            document.getElementById('driverVehicle').textContent = `${driverData.vehicle_plate_number} (${driverData.current_rank})`;
            
            // Set Avatar if available
            if(driverData.profiles.avatar_url) {
                document.getElementById('driverAvatar').src = driverData.profiles.avatar_url;
            }

            // Add Driver Marker to Map (if location exists)
            if (driverData.current_location) {
                // Note: PostGIS geography returns string like "POINT(lng lat)". 
                // We need to parse it carefully. For simplicity in JS, we might store separate lat/lng columns too.
                // Assuming we have separate fields or parsing logic:
                // Let's assume for this demo we fetch specific lat/lng from drivers table directly if needed.
                // Since our schema uses GEOGRAPHY, parsing in JS is tricky without a library.
                // Workaround: We will rely on Realtime updates sending explicit Lat/Lng if we modify schema later,
                // OR we just show the marker based on the last known position sent by driver dashboard.
                
                // For now, we'll skip precise driver marker rendering here to avoid complexity,
                // but the Realtime listener below WILL handle moving markers if we adjust the payload.
            }
        }

        // --- REALTIME SUBSCRIPTION ---
        function subscribeToRealtimeUpdates() {
            // Unsubscribe previous channel if any
            if (realtimeChannel) {
                supabase.removeChannel(realtimeChannel);
            }

            realtimeChannel = supabase
                .channel('booking-tracking')
                .on('postgres_changes', 
                    { 
                        event: '*', 
                        schema: 'public', 
                        table: 'bookings',
                        filter: `booking_id=eq.${currentBookingId}` 
                    }, 
                    (payload) => {
                        console.log('Change received!', payload);
                        handleUpdate(payload.new);
                    }
                )
                .on('postgres_changes',
                    {
                        event: 'UPDATE',
                        schema: 'public',
                        table: 'drivers',
                        // Filter needs to match the driver associated with THIS booking.
                        // This is complex in pure client-side RLS. 
                        // Simplification: We listen to ALL driver updates and check if it matches our booking's driver_id.
                    },
                    (payload) => {
                        // Check if this driver belongs to our current booking context
                        // We'd need to know the driver_id. Let's assume we stored it globally.
                        if (window.currentDriverId && payload.new.driver_id === window.currentDriverId) {
                             updateDriverLocationOnMap(payload.new);
                        }
                    }
                )
                .subscribe();
        }

        async function handleUpdate(updatedBooking) {
            // Update Status Badge & Timeline
            updateStatusUI(updatedBooking.trip_status);

            // If status changed to accepted/in-progress, ensure driver info is loaded
            if ((updatedBooking.trip_status === 'accepted' || updatedBooking.trip_status === 'in_progress') && driverSection.classList.contains('hidden')) {
                // Re-fetch full data to get driver details
                await loadInitialData(); 
            }

            // If cancelled or completed, stop listening or change UI
            if (updatedBooking.trip_status === 'cancelled') {
                alert("Trip Cancelled.");
                window.location.href = 'dashboard.html';
            } else if (updatedBooking.trip_status === 'completed') {
                showRatingPrompt();
            }
        }

        function updateStatusUI(status) {
            // Reset all steps
            ['requested', 'accepted', 'in_progress', 'completed'].forEach(s => {
                const el = document.getElementById(`step-${s}`);
                if(el) {
                    el.classList.remove('active', 'completed');
                }
            });

            // Activate current and mark previous as completed
            const order = ['requested', 'accepted', 'in_progress', 'completed'];
            const currentIndex = order.indexOf(status);

            if (currentIndex !== -1) {
                // Mark all previous as completed
                for(let i=0; i<currentIndex; i++) {
                    const prevEl = document.getElementById(`step-${order[i]}`);
                    if(prevEl) prevEl.classList.add('completed');
                }
                // Mark current as active
                const currEl = document.getElementById(`step-${status}`);
                if(currEl) currEl.classList.add('active');
            }

            // Update Badge Text/Color
            tripStatusBadge.textContent = status.replace('_', ' ').toUpperCase();
            tripStatusBadge.className = `badge ${getStatusColorClass(status)}`;
            
            // Hide Cancel button if trip started
            if (status === 'in_progress' || status === 'completed') {
                cancelBtn.style.display = 'none';
            } else {
                cancelBtn.style.display = 'block';
            }
        }

        function getStatusColorClass(status) {
            switch(status) {
                case 'requested': return 'bg-secondary';
                case 'accepted': return 'bg-info text-dark';
                case 'in_progress': return 'bg-primary';
                case 'completed': return 'bg-success';
                case 'cancelled': return 'bg-danger';
                default: return 'bg-secondary';
            }
        }

        function updateDriverLocationOnMap(driverRecord) {
            // Parse GeoJSON or WKT if necessary. 
            // For this MVP, let's assume we added simple lat/lng floats to drivers table for easier JS access
            // OR we use the payload if configured correctly.
            // *Correction*: Our schema uses GEOGRAPHY. Parsing that in browser JS is hard without proj4js.
            // STRATEGY: In the Driver Dashboard (File 6), we updated `current_location`. 
            // To make tracking easy, we should ideally also store `current_latitude` and `current_longitude` as decimals in Drivers table.
            // Let's assume for this file we just log it, or if you want perfect tracking, add those two decimal columns to `drivers` table in Supabase SQL.
            
            // TEMPORARY SOLUTION FOR DEMO:
            // If we had lat/lng, we would do:
            // const lat = driverRecord.current_latitude;
            // const lng = driverRecord.current_longitude;
            // if(!driverMarker) driverMarker = L.marker([lat,lng]).addTo(mapInstance);
            // else driverMarker.setLatLng([lat,lng]);
            
            console.log("Driver moved:", driverRecord);
        }

        // --- ACTIONS ---

        window.cancelRide = async function() {
            if(!confirm("Are you sure you want to cancel?")) return;
            
            try {
                const { error } = await supabase
                    .from('bookings')
                    .update({ trip_status: 'cancelled' })
                    .eq('booking_id', currentBookingId);
                
                if(error) throw error;
                alert("Ride cancelled.");
                window.location.href = 'dashboard.html';
            } catch(e) {
                alert("Failed to cancel: " + e.message);
            }
        };

        window.callDriver = function() {
            // Mock call action
            alert("Calling driver... (Integration with Twilio/Vonage required for real calls)");
        };

        function showRatingPrompt() {
            ratingModal.classList.remove('hidden');
            driverSection.classList.add('opacity-50'); // Dim other stuff
            
            // Star Logic
            const stars = document.querySelectorAll('#starContainer i');
            stars.forEach(star => {
                star.onclick = () => {
                    selectedRating = parseInt(star.getAttribute('data-val'));
                    // Visual feedback
                    stars.forEach(s => s.className = 'far fa-star fa-2x text-warning cursor-pointer'); // reset
                    for(let i=0; i<selectedRating; i++) {
                        stars[i].className = 'fas fa-star fa-2x text-warning cursor-pointer';
                    }
                };
            });
        }

        window.submitReview = async function() {
            if(selectedRating === 0) {
                alert("Please select a star rating.");
                return;
            }

            const comment = document.getElementById('reviewComment').value;
            
            try {
                // Insert into reviews_feedback
                const { error } = await supabase
                    .from('reviews_feedback')
                    .insert([{
                        booking_id: currentBookingId,
                        commuter_profile_id: (await supabase.auth.getUser()).data.user.id,
                        driver_profile_id: window.currentDriverId, // Need to capture this during load
                        rating_stars: selectedRating,
                        comment_text: comment,
                        is_public: true
                    }]);

                if(error) throw error;

                alert("Thank you for your feedback!");
                window.location.href = 'dashboard.html';

            } catch(e) {
                alert("Failed to submit review: " + e.message);
            }
        };

        // Cleanup
        window.addEventListener('beforeunload', () => {
            if (realtimeChannel) {
                supabase.removeChannel(realtimeChannel);
            }
        });

    </script>
</body>
</html>
