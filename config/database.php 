/**
 * Simple .env Loader
 * Loads environment variables from the root .env file into $_ENV superglobal
 */
function loadEnv($path = __DIR__ . '/../.env') {
    if (!file_exists($path)) return;
    
    $lines = file($path, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
    foreach ($lines as $line) {
        // Skip comments
        if (strpos(trim($line), '#') === 0) continue;
        
        // Parse KEY=VALUE
        list($name, $value) = explode('=', $line, 2);
        $name = trim($name);
        $value = trim($value);
        
        // Remove surrounding quotes if present
        if ((substr($value, 0, 1) === '"' && substr($value, -1, '"') === '"') || 
            (substr($value, 0, 1) === "'" && substr($value, -1, "'") === "'")) {
            $value = substr($value, 1, -1);
        }
        
        putenv("$name=$value");
        $_ENV[$name] = $value;
    }
}

// Load env vars before connecting
loadEnv();

$host = getenv('DB_HOST') ?: 'localhost';
$db   = getenv('DB_DATABASE') ?: 'pahatid_db';
$user = getenv('DB_USERNAME') ?: 'root';
$pass = getenv('DB_PASSWORD') ?: '';
$charset = 'utf8mb4';

$dsn = "mysql:host=$host;dbname=$db;charset=$charset";

$options = [
    PDO::ATTR_ERRMODE            => PDO::ERRMODE_EXCEPTION,
    PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
    PDO::ATTR_EMULATE_PREPARES   => false, // Use real prepared statements for security
];

try {
    // Create a PDO instance
    $pdo = new PDO($dsn, $user, $pass, $options);
    
    // Optional: Set timezone to Philippines time explicitly in DB session
    $pdo->exec("SET time_zone = '+08:00'");

} catch (\PDOException $e) {
    // Log error safely without exposing credentials on screen
    error_log("Database Connection Failed: " . $e->getMessage());
    
    // Show generic message to user (security best practice)
    die(json_encode(['error' => 'System maintenance. Please try again later.', 'code' => 500]));
}

// Return the PDO object for use in other scripts
return $pdo;
?>
