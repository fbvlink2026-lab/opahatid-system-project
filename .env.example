# APP CONFIGURATION
APP_NAME="Pahatid System"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/pahatid-system-project

# DATABASE CONFIGURATION
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=pahatid_db
DB_USERNAME=root
DB_PASSWORD="" 

# SECURITY KEYS
# Generate these using random string generators
SECRET_KEY=your_generated_secret_key_here
DRIVER_LOGIN_SALT=your_random_salt_for_driver_auth

# EXTERNAL SERVICES (Optional for Phase 1, but good practice to include)
MAPBOX_TOKEN="" 
GOOGLE_MAPS_API_KEY=""

# MAIL CONFIGURATION (For notifications/receipts)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_ENCRYPTION=tls

# SITE SETTINGS DEFAULTS
DEFAULT_LANGUAGE=en
BASE_FARE_RATE=40.00
KM_RATE=15.00
